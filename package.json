{
  "name": "vula",
  "private": true,
  "type": "module",
  "description": "Tamper-evident audit trail anchored on Compellio TARs",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "m0:smoke": "tsx packages/compellio/scripts/m0-smoke.ts",
    "testnet": "tsx packages/compellio/scripts/testnet.ts",
    "vula": "tsx apps/cli/src/main.ts",
    "log-server": "pnpm --filter @vula/log-server start",
    "collector": "pnpm --filter @vula/collector start",
    "attack": "tsx attacks/src/cli.ts",
    "grades-demo": "pnpm --filter @vula/grades-demo start",
    "stack:up": "tsx scripts/stack.ts up",
    "stack:down": "tsx scripts/stack.ts down",
    "stack:status": "tsx scripts/stack.ts status",
    "e2e:attacks": "tsx scripts/e2e-attacks.ts",
    "e2e:stretch": "tsx scripts/e2e-stretch.ts",
    "dashboard:smoke": "tsx scripts/dashboard-smoke.ts",
    "realtime:smoke": "tsx scripts/realtime-smoke.ts",
    "demo:reset": "tsx scripts/stack.ts down log-server collector && tsx attacks/src/cli.ts reset && tsx scripts/stack.ts up log-server collector"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "22.20.5",
    "@vula/attacks": "workspace:*",
    "@vula/db": "workspace:*",
    "@vula/verifier": "workspace:*",
    "supabase": "2.122.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild"
    ]
  }
}
