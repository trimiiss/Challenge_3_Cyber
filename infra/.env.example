DCAP_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DCAP_BLOCKCHAIN_URL=http://chain:8545/
DCAP_BLOCKCHAIN_ID=31337
DCAP_URI_PREFIX=http://localhost:4000/tar/

