# Copy to .env (gitignored) and fill in. Used by every Node app and script in this repo.

# --- Compellio Registry API --------------------------------------------------
# dcap-local = open-source DCAP.Web from infra/docker-compose.yml
# gateway    = hosted Compellio Gateway Registry API (needs API key + credits)
# mock       = in-memory, unit tests only
REGISTRY_MODE=dcap-local
REGISTRY_URL=http://localhost:6060
# Gateway only (REGISTRY_URL defaults to https://registry.api.gateway.compellio.com/ in gateway mode)
GATEWAY_API_KEY=
GATEWAY_NETWORK=
GATEWAY_ISSUER_DOMAIN=

# --- Chain (read side; the verifier only needs this) ----------------------------
CHAIN_RPC_URL=http://localhost:8545
# Etherlink Shadownet testnet: CHAIN_RPC_URL=https://node.shadownet.etherlink.com
# The auditor's pinned TAR id (published out of band). If empty, the CLI falls back to vula.config (untrusted).
VULA_TAR_ID=

# --- Supabase project -----------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com

# Least-privilege Postgres login roles (supabase/migrations/*_vula_roles_rls.sql). Set each with
#   alter role <role> password '...';
VULA_LOG_DB_PASSWORD=
VULA_AUDITOR_DB_PASSWORD=
UIBM_APP_DB_PASSWORD=
UIBM_ADMIN_DB_PASSWORD=

# Supabase Auth demo users (created by supabase/seed.sql)
PROF_EMAIL=prof.krasniqi@uibm.test
PROF_PASSWORD=
AUDITOR_EMAIL=auditor@vula.test
AUDITOR_PASSWORD=
LOGSERVER_EMAIL=logserver@vula.test
LOGSERVER_PASSWORD=

# --- Checkpoint signing. Ed25519 PKCS#8 DER base64 (`pnpm vula keygen`). Never stored in Supabase.
VULA_SIGNING_KEY=
VULA_SIGNING_KEY_ID=vula-2026-1
VULA_LOG_ID=uibm-grades-prod

# --- Log server / collector -----------------------------------------------------
VULA_INGEST_TOKEN=
LOG_SERVER_URL=http://localhost:4000
CHECKPOINT_INTERVAL_MS=60000     # 1 min locally, 300000 on testnet
HEARTBEAT_INTERVAL_MS=60000
HEARTBEAT_GAP_MS=150000          # alert after 2.5 missed heartbeats
